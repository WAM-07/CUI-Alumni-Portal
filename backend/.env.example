APP_NAME="AlumniPortal"
APP_VERSION="1.0.0"
DEBUG=False
API_PREFIX="/api"

# Database (MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority)
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="alumni_db"

# Cache (Redis)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0

# Security (JWT)
JWT_SECRET_KEY="generate_a_secure_random_key_for_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Notification (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_EMAIL="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"
SMTP_FROM="noreply@comsats.edu.pk"

# Cloud Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
